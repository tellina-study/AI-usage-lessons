        "url": "https://openrouter.ai/api/alpha/decisions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: \"typesafe/jev-1.13\", state: { previous_message: $json.body.text_old, new_message: $json.body.text_new }, questions: { same_question: { type: \"noul\", instructions: \"Новое сообщение клиента учебного центра — это тот же вопрос, что и недавнее сообщение того же контакта, просто переформулированный (перефразировка), а не новый, другой по смыслу вопрос?\", criteria: { true: \"Это переформулировка того же вопроса, который уже был задан — смысл совпадает, слова разные.\", false: \"Это другой по смыслу вопрос, даже если тема или часть слов похожи.\" } } } }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "judge_model",
      "name": "Judge model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        60,
        180
      ],
      "parameters": {
        "model": "openai/gpt-4o-mini",
        "options": {}
      },
      "credentials": {
        "openRouterApi": {
          "id": "VbxiQn8TbqA4R2mw",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "id": "judge",
      "name": "LLM judge",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        320,
        180
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Это новое сообщение: «{{ $json.body.text_new }}». Недавнее сообщение того же контакта: «{{ $json.body.text_old }}». Это тот же вопрос, просто сформулированный иначе? Ответь строго «да» или «нет».",
        "options": {}
      }
    },
    {
      "id": "combine",
      "name": "Combine",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        560,
        30
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
