+def _sosedi(d, w, st=DEFAULT):
+    """Соседние подписи одной дорожки после раскладки: `(i, j, наезд,
+    во сколько раз подписи разъехались шире своих засечек)`.
+
+    Две беды, и обе меряются здесь, потому что обе — про одну пару:
+
+    * НАЕЗД — раскладка не смогла развести подписи в отведённой ширине
+      (`наезд > 0`). На полной ширине тела это почти невозможно: потолок
+      рамки — `lane_w`, то есть доля оси, и сумма долей в дорожку всегда
+      влезает. Остаётся узкая колонка — там случается;
+    * РАЗЪЕХАЛИСЬ — развести удалось, но ценой такого сдвига, что подписи
+      стоят ВТРОЕ дальше друг от друга, чем их засечки. Это прямая ложь
+      той единственной вещи, ради которой ось заведена: расстояние между
+      засечками пропорционально разнице величин. Наезда при этом нет, и
+      прежняя проверка такой кадр пропускала молча."""
+    place = _place(d, 0.0, w, st)
+    lanes = _lanes(d)
+    out = []
+    for up in (True, False):
+        idx = sorted([i for i in range(len(d["marks"])) if lanes[i] == up],
+                     key=lambda i: d["marks"][i]["v"])
+        for a, b in zip(idx, idx[1:]):
+            la, wa, _, _ = place[a]
+            lb, wb, _, _ = place[b]
+            naezd = (la + wa + st.lab_gap) - lb
+            shag_z = abs(_x_of(d["marks"][b]["v"], d, 0.0, w, st)
+                         - _x_of(d["marks"][a]["v"], d, 0.0, w, st))
+            shag_p = abs((lb + wb / 2) - (la + wa / 2))
+            k = shag_p / shag_z if shag_z > 1e-6 else float("inf")
+            out.append((a, b, naezd, k))
+    return out
+
