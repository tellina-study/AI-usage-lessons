      "typeVersion": 1,
      "position": [
        280,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "output.topics",
        "include": "allOtherFields",
        "destinationFieldName": "topic_raw",
        "options": {}
      }
    },
    {
      "id": "vocab",
