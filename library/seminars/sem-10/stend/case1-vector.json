    {
      "id": "pick",
      "name": "Simple Vector Store (cosine top-1)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        0
      ],
      "parameters": {
        "jsCode": "const payload = JSON.parse($('Вопрос + корпус с векторами').first().json.payload);\nconst qvec = $input.first().json.data[0].embedding;\nfunction cos(a,b){let d=0,na=0,nb=0;for(let i=0;i<a.length;i++){d+=a[i]*b[i];na+=a[i]*a[i];nb+=b[i]*b[i];}return d/(Math.sqrt(na)*Math.sqrt(nb));}\nlet best=null,bestScore=-1;\nfor(const doc of payload.corpus){const s=cos(qvec,doc.embedding);if(s>bestScore){bestScore=s;best=doc;}}\nreturn [{json:{question:payload.question,chunk:best.text,doc_id:best.id,score:bestScore,model:payload.model}}];"
      }
    },
    {
      "id": "model",
      "name": "Model (answer on retrieved chunk)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
