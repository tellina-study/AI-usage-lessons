{
  "name": "С11 · Кейс 1 — HyDE перед поиском (демо-экран)",
  "nodes": [
    {
      "id": "trig",
      "name": "Вопрос + корпус с векторами",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -900,
        0
      ],
      "webhookId": "s11-case1-hyde",
      "parameters": {
        "path": "s11-case1-hyde",
        "formTitle": "С11 · Кейс 1 — HyDE (демо)",
        "formDescription": "JSON: {question, corpus: [{id, text, embedding}]}",
        "formFields": {
          "values": [
            {
              "fieldLabel": "payload",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "hyde_gen",
      "name": "Сочинить гипотетический ответ (gpt-4o-mini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -620,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'openai/gpt-4o-mini',\n  messages: [{role: 'user', content: 'Представь, что ты пишешь короткий (2-3 предложения) энциклопедический фрагмент текста, который мог бы содержать ответ на следующий вопрос — связный абзац в стиле статьи, а не прямой ответ одним словом. Если точных деталей не знаешь — всё равно сочини правдоподобный по стилю фрагмент (это гипотетический документ для поиска, не факт). Ответь ТОЛЬКО текстом фрагмента, без пояснений.\\n\\nВопрос: ' + JSON.parse($json.payload).question }]\n}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 60000
        }
      },
      "credentials": {
        "openRouterApi": {
          "id": "VbxiQn8TbqA4R2mw",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "id": "parse_hyde",
      "name": "Разбор HyDE-документа",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -340,
        0
      ],
      "parameters": {
        "jsCode": "const payload = JSON.parse($('Вопрос + корпус с векторами').first().json.payload);\nconst resp = $input.first().json;\nlet hyde_text = null;\ntry { hyde_text = resp.choices[0].message.content; } catch (e) {}\nreturn [{json: {question: payload.question, corpus: payload.corpus, hyde_text}}];"
      }
    },
    {
      "id": "embed_hyde",
      "name": "Embed HyDE-документ (text-embedding-3-small)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -60,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: 'openai/text-embedding-3-small', input: $json.hyde_text}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 60000
        }
      },
      "credentials": {
        "openRouterApi": {
          "id": "VbxiQn8TbqA4R2mw",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "id": "vec_search",
      "name": "Simple Vector Store (cosine top-1 по HyDE)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const prev = $('Разбор HyDE-документа').first().json;\nconst qvec = $input.first().json.data[0].embedding;\nfunction cos(a, b) {\n  let d = 0, na = 0, nb = 0;\n  for (let i = 0; i < a.length; i++) { d += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }\n  return d / (Math.sqrt(na) * Math.sqrt(nb));\n}\nlet best = null, bestScore = -1;\nfor (const doc of prev.corpus) {\n  const s = cos(qvec, doc.embedding);\n  if (s > bestScore) { bestScore = s; best = doc; }\n}\nreturn [{json: {question: prev.question, hyde_text: prev.hyde_text, chunk: best.text, doc_id: best.id, score: bestScore}}];"
      }
    },
    {
      "id": "answer",
      "name": "Answer (RAG) по найденному куску (gpt-4o-mini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'openai/gpt-4o-mini',\n  messages: [{role: 'user', content: 'Отвечай ТОЛЬКО по тексту ниже. Если ответа нет в тексте — напиши «нет информации».\\n\\nТекст:\\n' + $json.chunk + '\\n\\nВопрос: ' + $json.question}]\n}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 60000
        }
      },
      "credentials": {
        "openRouterApi": {
          "id": "VbxiQn8TbqA4R2mw",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "id": "res",
      "name": "Result screen",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [
        740,
        0
      ],
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Ответ (HyDE)",
        "completionMessage": "={{ 'HyDE-документ: ' + $('Simple Vector Store (cosine top-1 по HyDE)').first().json.hyde_text + '\\n\\nНайден документ: ' + $('Simple Vector Store (cosine top-1 по HyDE)').first().json.doc_id + ' (score ' + $('Simple Vector Store (cosine top-1 по HyDE)').first().json.score.toFixed(3) + ')\\n\\nОтвет: ' + $json.choices[0].message.content }}",
        "options": {
          "appendAttribution": false
        }
      }
    }
  ],
