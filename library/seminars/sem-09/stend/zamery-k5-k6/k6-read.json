{
  "name": "С9 · замер K6 — чтение фотографии квитанции",
  "nodes": [
    {
      "id": "k6_webhook",
      "name": "Receipt photo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -180,
        0
      ],
      "webhookId": "s9-m6-read",
      "parameters": {
        "httpMethod": "POST",
        "path": "s9-m6-read",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "k6_build_body",
      "name": "Build vision request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        60,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "model",
              "type": "string",
              "value": "qwen/qwen3-vl-8b-instruct"
            },
            {
              "id": "b2",
              "name": "data_url",
              "type": "string",
              "value": "={{ 'data:' + $json.body.mime_type + ';base64,' + $json.body.image_base64 }}"
            },
            {
              "id": "b3",
              "name": "receipt_id",
              "type": "string",
              "value": "={{ $json.body.receipt_id }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "k6_http",
      "name": "Read receipt (OpenRouter vision)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $json.model,\n  messages: [{\n    role: 'user',\n    content: [\n      { type: 'text', text: \"На фотографии — квитанция об оплате курса учебного центра, снятая телефоном (возможны перекос, шум, нерезкость). Прочитай с неё СУММУ платежа и ДАТУ. Ответь СТРОГО в формате JSON без markdown-разметки и пояснений вокруг: {\\\"sum_rub\\\": <число без пробелов и валюты, например 18990.00>, \\\"date\\\": \\\"<дата в формате ДД.ММ.ГГГГ как написана на квитанции>\\\", \\\"raw_text_seen\\\": \\\"<что именно ты прочитал в строке суммы, дословно>\\\"}. Если строку суммы или даты невозможно разобрать уверенно — всё равно верни лучшую догадку в sum_rub/date, а в raw_text_seen честно напиши, что не уверена.\" },\n      { type: 'image_url', image_url: { url: $json.data_url } }\n    ]\n  }],\n  response_format: { type: 'json_object' },\n  temperature: 0.2\n}) }}",
        "options": {}
      },
      "credentials": {
        "openRouterApi": {
          "id": "VbxiQn8TbqA4R2mw",
          "name": "OpenRouter account"
        }
      }
    }
  ],
  "connections": {
    "Receipt photo": {
      "main": [
        [
          {
            "node": "Build vision request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build vision request": {
      "main": [
        [
          {
            "node": "Read receipt (OpenRouter vision)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
