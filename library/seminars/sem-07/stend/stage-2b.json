            "request_text": "={{ $('Request form').item.json['Что нужно'] }}",
            "topic": "={{ $json.topic }}",
            "urgency": "={{ $json.urgency }}",
            "contact_from_text": "={{ $json.contact_from_text }}",
            "status": "={{ $json.status }}",
            "extra_topics": "={{ $json.extra_topics || '' }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "screen",
      "name": "Result screen",
