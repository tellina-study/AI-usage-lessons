{
  "name": "С9 · замер K6 — единый вызов (чтение+сверка)",
  "nodes": [
    {
      "id": "k6e_webhook",
      "name": "Receipt + claim",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -180,
        0
      ],
      "webhookId": "s9-m6-edinyy",
      "parameters": {
        "httpMethod": "POST",
        "path": "s9-m6-edinyy",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "k6e_build_body",
      "name": "Build vision request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        60,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "model",
              "type": "string",
              "value": "qwen/qwen3-vl-8b-instruct"
            },
            {
              "id": "b2",
              "name": "data_url",
              "type": "string",
              "value": "={{ 'data:' + $json.body.mime_type + ';base64,' + $json.body.image_base64 }}"
            },
            {
              "id": "b3",
              "name": "receipt_id",
              "type": "string",
              "value": "={{ $json.body.receipt_id }}"
            },
            {
              "id": "b4",
              "name": "text",
              "type": "string",
              "value": "={{ $json.body.prompt_text }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "k6e_http",
      "name": "Read + sverka (OpenRouter vision, единый вызов)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $json.model,\n  messages: [{\n    role: 'user',\n    content: [\n      { type: 'text', text: $json.text },\n      { type: 'image_url', image_url: { url: $json.data_url } }\n    ]\n  }],\n  response_format: { type: 'json_object' },\n  temperature: 0.2\n}) }}",
        "options": {}
      },
      "credentials": {
        "openRouterApi": {
          "id": "VbxiQn8TbqA4R2mw",
          "name": "OpenRouter account"
        }
      }
    }
  ],
