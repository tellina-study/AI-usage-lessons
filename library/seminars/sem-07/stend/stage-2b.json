      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Заявка разобрана: записей несколько",
        "completionMessage": "=<div style=\"margin:0 0 14px;padding:10px 12px;border-left:3px solid #1C7293;background:#F4F7FA\"><div style=\"font-size:12px;color:#5B6B7F;letter-spacing:.04em\">ШАГ 1</div><div style=\"font-weight:700;margin:2px 0 6px\">Форма</div><div style=\"line-height:1.5\">{{ $('Request form').item.json['Что нужно'] }}</div></div><div style=\"margin:0 0 14px;padding:10px 12px;border-left:3px solid #1C7293;background:#F4F7FA\"><div style=\"font-size:12px;color:#5B6B7F;letter-spacing:.04em\">ШАГ 2</div><div style=\"font-weight:700;margin:2px 0 6px\">Извлечение — что предложила модель</div><div style=\"line-height:1.5\">темы: <b>{{ $('Extract fields').first().json.output.topics.join(' · ') }}</b><br>срочность: <b>{{ $('Extract fields').first().json.output.urgency }}</b></div></div><div style=\"margin:0 0 14px;padding:10px 12px;border-left:3px solid #1C7293;background:#F4F7FA\"><div style=\"font-size:12px;color:#5B6B7F;letter-spacing:.04em\">ШАГ 3</div><div style=\"font-weight:700;margin:2px 0 6px\">Расщепление — сколько записей вышло из одного письма</div><div style=\"line-height:1.5\">элементов после Split topics: <b>{{ $('Split topics').all().length }}</b></div></div><div style=\"margin:0 0 14px;padding:10px 12px;border-left:3px solid #1C7293;background:#F4F7FA\"><div style=\"font-size:12px;color:#5B6B7F;letter-spacing:.04em\">ШАГ 4</div><div style=\"font-weight:700;margin:2px 0 6px\">Запись</div><div style=\"line-height:1.5\">строк добавлено в таблицу requests: <b>{{ $('Write row').all().length }}</b><br>темы записей: <b>{{ $('Write row').all().map(i => i.json.topic).join(' · ') }}</b></div></div>",
        "options": {
          "appendAttribution": false
        }
      }
    }
