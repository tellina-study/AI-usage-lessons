# === Lectures (17, canon labels + LO + covers->topic) ===
aiul:lec_01 a aiul:Lecture ;
	rdfs:label "Lecture 1: Introduction — AI in the modern world" ;
	aiul:covers aiul:topic_ai_fundamentals , aiul:topic_ai_agents , aiul:topic_prompt_engineering ,
		aiul:lo1 , aiul:lo4 , aiul:lo6 ;
	aiul:status "draft" ;
	aiul:source_url "https://docs.google.com/document/d/1UX671dOrhfQ8OgnadD_8ce4dhVJ9wDVrFqPq6p9S9uo/edit"^^xsd:anyURI ;
	aiul:updated_at "2026-04-07T00:00:00"^^xsd:dateTime .
aiul:lec_02 a aiul:Lecture ;
	rdfs:label "Lecture 2: AI Architecture — from ML to Transformers" ;
	aiul:covers aiul:topic_ai_fundamentals , aiul:lo1 , aiul:lo6 , aiul:lo7 ;
	aiul:status "draft" .
aiul:lec_03 a aiul:Lecture ;
	rdfs:label "Lecture 3: AI-System Architectures — Agents, RAG, API" ;
