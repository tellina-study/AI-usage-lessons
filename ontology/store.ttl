# === Seminars (17, canon labels + assesses->LO per course-plan-seminars.md) ===
aiul:sem_01 a aiul:Seminar ;
	rdfs:label "Seminar 1: Which type of AI to choose — 4 questions of an IU6 engineer" ;
	aiul:assesses aiul:lo1 , aiul:lo4 , aiul:lo6 .
aiul:sem_02 a aiul:Seminar ;
	rdfs:label "Seminar 2: Why a prompt works — tokens, context, attention" ;
	aiul:assesses aiul:lo1 , aiul:lo6 , aiul:lo7 .
aiul:sem_03 a aiul:Seminar ;
	rdfs:label "Seminar 3: Architectural choice — chat, agent, RAG or API (three cases)" ;
	aiul:assesses aiul:lo4 , aiul:lo7 .
aiul:sem_04 a aiul:Seminar ;
	rdfs:label "Seminar 4: AI in the software development cycle" ;
	aiul:assesses aiul:lo1 , aiul:lo4 , aiul:lo7 .
aiul:sem_05 a aiul:Seminar ;
	rdfs:label "Seminar 5: Fact-checking AI on financial data" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo3 , aiul:lo6 .
aiul:sem_06 a aiul:Seminar ;
	rdfs:label "Seminar 6: Generative design and the cost of error — engineering cases" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo7 .
aiul:sem_07 a aiul:Seminar ;
	rdfs:label "Seminar 7: AI diagnostics — sensitivity, specificity, responsibility" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo3 , aiul:lo8 .
aiul:sem_08 a aiul:Seminar ;
	rdfs:label "Seminar 8: Midterm Control 1 (Module 1)" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo3 , aiul:lo4 , aiul:lo5 , aiul:lo6 , aiul:lo7 , aiul:lo8 .
aiul:sem_09 a aiul:Seminar ;
	rdfs:label "Seminar 9: Autonomy levels and certification — where AI does not decide" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo3 , aiul:lo7 .
aiul:sem_10 a aiul:Seminar ;
	rdfs:label "Seminar 10: Cognitive Agro Pilot and precision farming" ;
	rdfs:comment "Canon source inconsistency: the per-seminar tag in course-plan-seminars.md reads 'LO1, LO2, LO5', but the authoritative LO-coverage table (§Покрытие LO по семинарам, LO5 row) lists seminars 8,12,15,17 — NOT 10. assesses aligned to the coverage table per issue #97/#95 task spec. Flagged for owner: confirm whether sem_10 assesses LO5." ;
	aiul:assesses aiul:lo1 , aiul:lo2 .
aiul:sem_11 a aiul:Seminar ;
	rdfs:label "Seminar 11: Predictive maintenance and cobots — shop-floor architecture" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo7 , aiul:lo8 .
aiul:sem_12 a aiul:Seminar ;
	rdfs:label "Seminar 12: Midterm Control 2 (Module 2)" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo3 , aiul:lo5 , aiul:lo7 , aiul:lo8 .
aiul:sem_13 a aiul:Seminar ;
	rdfs:label "Seminar 13: Routing, warehouses and last mile" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo7 .
aiul:sem_14 a aiul:Seminar ;
	rdfs:label "Seminar 14: AI as shield and sword — attacking and defending networks" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo3 , aiul:lo7 .
aiul:sem_15 a aiul:Seminar ;
	rdfs:label "Seminar 15: AI for thesis work — literature review, AlphaFold, mandatory disclosure" ;
	aiul:assesses aiul:lo4 , aiul:lo5 , aiul:lo6 , aiul:lo8 .
aiul:sem_16 a aiul:Seminar ;
	rdfs:label "Seminar 16: Seismic, pipeline, well — AI architecture for oil & gas" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo3 , aiul:lo7 .
aiul:sem_17 a aiul:Seminar ;
	rdfs:label "Seminar 17: Midterm Control 3 — final synthesis of the whole course" ;
	aiul:assesses aiul:lo1 , aiul:lo2 , aiul:lo3 , aiul:lo4 , aiul:lo5 , aiul:lo6 , aiul:lo7 , aiul:lo8 .

# === Concepts (preserved verbatim from prior store; lecture-1 knowledge graph) ===
aiul:concept_taxonomy_task_type a aiul:Concept ;
	rdfs:label "Taxonomy: By Task Type (Russell & Norvig 2021)" ;
	aiul:belongs_to_topic aiul:topic_ai_fundamentals .
aiul:concept_taxonomy_modality a aiul:Concept ;
	rdfs:label "Taxonomy: By Modality (Baltrusaitis et al. 2019)" ;
	aiul:belongs_to_topic aiul:topic_ai_fundamentals .
aiul:concept_taxonomy_learning a aiul:Concept ;
	rdfs:label "Taxonomy: By Learning Approach (Mitchell 1997, Bishop 2006, Sutton & Barto 2018)" ;
	aiul:belongs_to_topic aiul:topic_ai_fundamentals .
aiul:concept_taxonomy_capability a aiul:Concept ;
	rdfs:label "Taxonomy: By Capability Level ANI/AGI/ASI (Searle 1980, Bostrom 2014)" ;
	aiul:belongs_to_topic aiul:topic_ai_fundamentals .
aiul:concept_taxonomy_architecture a aiul:Concept ;
	rdfs:label "Taxonomy: By Architecture (Vaswani et al. 2017, Ho et al. 2020)" ;
	aiul:belongs_to_topic aiul:topic_ai_fundamentals .
aiul:concept_taxonomy_gen_disc a aiul:Concept ;
	rdfs:label "Taxonomy: Generative vs Discriminative (Ng & Jordan 2001, Goodfellow et al. 2014)" ;
	aiul:belongs_to_topic aiul:topic_ai_fundamentals .
aiul:concept_taxonomy_foundation a aiul:Concept ;
	rdfs:label "Taxonomy: Foundation Models (Bommasani et al. 2021)" ;
	aiul:belongs_to_topic aiul:topic_ai_fundamentals .
aiul:concept_taxonomy_agentic a aiul:Concept ;
	rdfs:label "Taxonomy: Agentic AI (Masterman et al. 2024)" ;
	aiul:belongs_to_topic aiul:topic_ai_fundamentals ;
	aiul:related_concept aiul:concept_agent_architectures .
aiul:concept_taxonomy_hintze a aiul:Concept ;
	rdfs:label "Taxonomy: Hintze 4 Types - reactive/limited memory/ToM/self-aware (Hintze 2016)" ;
	aiul:belongs_to_topic aiul:topic_ai_fundamentals .
aiul:concept_agent_definitions a aiul:Concept ;
	rdfs:label "Agent definitions: model/chat/agent/app hierarchy (Weng 2023, Google 2024)" ;
	aiul:belongs_to_topic aiul:topic_ai_agents .
aiul:concept_agent_architectures a aiul:Concept ;
	rdfs:label "Agent architectures: ReAct, Toolformer, Anthropic spectrum, Ng patterns" ;
	aiul:belongs_to_topic aiul:topic_ai_agents .
aiul:concept_agent_papers a aiul:Concept ;
	rdfs:label "Agent key papers: Yao 2022, Schick 2023, Wang 2023, Masterman 2024, Liu 2025" ;
	aiul:belongs_to_topic aiul:topic_ai_agents .
aiul:concept_agent_frameworks a aiul:Concept ;
	rdfs:label "Agent frameworks: Claude Code, Devin, AutoGPT, CrewAI, LangGraph, OpenAI Assistants" ;
	aiul:belongs_to_topic aiul:topic_ai_agents .
aiul:concept_agent_course_coverage a aiul:Concept ;
	rdfs:label "Agent course coverage: Lecture 1 overview, no dedicated lecture" ;
	aiul:belongs_to_topic aiul:topic_ai_agents .
aiul:concept_agent_capabilities a aiul:Concept ;
	rdfs:label "Agent capabilities: planning, tool use, memory, multi-agent collaboration" ;
	aiul:belongs_to_topic aiul:topic_ai_agents .
aiul:concept_agent_autonomy a aiul:Concept ;
	rdfs:label "Agent autonomy levels: L1 Operator to L5 Observer (arXiv:2506.12469)" ;
	aiul:belongs_to_topic aiul:topic_ai_agents .
aiul:concept_agent_ontology a aiul:Concept ;
	rdfs:label "Agent ontology: topic node, research doc, concept entities in knowledge graph" ;
	aiul:belongs_to_topic aiul:topic_ai_agents .

