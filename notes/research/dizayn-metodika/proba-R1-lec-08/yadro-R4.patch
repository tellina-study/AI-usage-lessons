+            off = (lx[k] + ws[k] / 2) - mxs[k]
+            al = (PP_ALIGN.CENTER if abs(off) <= st.lab_slack else
+                  PP_ALIGN.LEFT if off > 0 else PP_ALIGN.RIGHT)
+            out[i] = (lx[k], ws[k], al, off)
+    return out
