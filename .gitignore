# Exported Google artifacts (may contain sensitive content)
catalog/exports/docs/
catalog/exports/sheets/
catalog/exports/slides/
catalog/exports/pdf/
# Viz outputs ARE committed (needed for viewing)
!catalog/exports/viz/

# RAG index data
catalog/index/

# Environment and secrets
.env
.env.*
.claude/settings.local.json
.mcp.json
*.key
*.pem
credentials.json
token.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Downloaded papers (PDFs) — track manifests, ignore binaries
library/papers/**/*.pdf
library/papers/**/*.epub

# Oxigraph data
oxigraph-data/

# Local RAG data (LanceDB + models)
lancedb/
models/
scripts/__pycache__/
lib/

# Presentation rendering archives (intermediate iterations kept locally only)
# Only final rendered/lec-NN-pilot.{pptx,pdf} + snapshots + assets stay in git
library/lectures/*/rendered/archive-v*/

# Lecture rendered snapshots — derived ephemeral, regeneratable from PPTX
library/lectures/*/rendered/snapshots/

# Office temp lock files
~$*
library/lectures/*/rendered/~$*

# Python bytecode
__pycache__/
*.pyc

# рабочие сборки разностного замера круга диеты (#229) — бинарники не хранятся
library/lectures/lec-07/rework/deck/zamer-diyeta-r7-r10/*.pptx
library/lectures/lec-07/rework/deck/zamer-diyeta-r7-r10/slides-do/
library/lectures/lec-07/rework/deck/zamer-diyeta-r7-r10/*.pdf
library/lectures/lec-07/rework/deck/chastichnaya-sborka.pptx
# ...и её рендер: правило игнорировало только pptx, а `--only` оставляет рядом и pdf,
# который иначе попадает в коммит как случайный артефакт (круг #285, раздел 5).
library/lectures/lec-07/rework/deck/chastichnaya-sborka.pdf

# Точечная сборка одного кадра (`build.py --block nNN`) кладёт результат рядом с
# декой под именем `sem-NN-nMM.pptx`. Это рабочий файл на один взгляд, а не
# артефакт: 48 таких попало в историю разом, когда каталог `rendered/` добавили
# целиком — 3,2 МБ двоичных файлов, которые никто никогда не откроет.
library/seminars/*/rendered/sem-*-n*.pptx
