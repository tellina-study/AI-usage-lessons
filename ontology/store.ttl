aiul:diag_semester_roadmap a aiul:Diagram ;
	aiul:title "Semester Roadmap — 14 lessons across 3 blocks" ;
	aiul:source_system "local" ;
	aiul:source_url "diagrams/lecture-flows/semester-roadmap.drawio" ;
	aiul:status "active" ;
	aiul:updated_at "2026-03-31T00:00:00"^^xsd:dateTime ;
	aiul:illustrates aiul:doc_v2_course_plan .

# === Schema mirror: classes, properties, vocabulary (preserved verbatim) ===
aiul:Document a rdfs:Class ; rdfs:label "Document" ;
	rdfs:comment "Any managed document (normative, reference, etc.)" .
aiul:Section a rdfs:Class ; rdfs:label "Section" ;
	rdfs:comment "A section within a document" .
aiul:Requirement a rdfs:Class ; rdfs:label "Requirement" ;
	rdfs:comment "A normative requirement extracted from documents" .
aiul:Lecture a rdfs:Class ; rdfs:label "Lecture" ;
	rdfs:comment "A single lecture in the course" .
aiul:SlideDeck a rdfs:Class ; rdfs:label "SlideDeck" ;
	rdfs:comment "A presentation (Google Slides or local)" .
aiul:Diagram a rdfs:Class ; rdfs:label "Diagram" ;
	rdfs:comment "A draw.io or other diagram artifact" .
aiul:Task a rdfs:Class ; rdfs:label "Task" ;
	rdfs:comment "A tracked task (linked to GitHub Issue)" .
aiul:Topic a rdfs:Class ; rdfs:label "Topic" ;
	rdfs:comment "A thematic topic grouping entities" .
aiul:LearningOutcome a rdfs:Class ; rdfs:label "LearningOutcome" ;
	rdfs:comment "A learning outcome that links requirements to lectures" .
aiul:Seminar a rdfs:Class ; rdfs:label "Seminar" ;
	rdfs:comment "A seminar session that assesses learning outcomes" .
aiul:cites a rdfs:Property ; rdfs:label "cites" ;
	rdfs:comment "Source cites target document/section" .
aiul:covers a rdfs:Property ; rdfs:label "covers" ;
	rdfs:comment "Lecture or deck covers a topic or requirement" .
aiul:illustrates a rdfs:Property ; rdfs:label "illustrates" ;
	rdfs:comment "Diagram illustrates a document, lecture, or concept" .
aiul:depends_on a rdfs:Property ; rdfs:label "depends_on" ;
	rdfs:comment "Entity depends on another entity" .
aiul:supersedes a rdfs:Property ; rdfs:label "supersedes" ;
	rdfs:comment "Newer version supersedes older" .
aiul:tracked_by a rdfs:Property ; rdfs:label "tracked_by" ;
	rdfs:comment "Entity is tracked by a task/issue" .
aiul:belongs_to_topic a rdfs:Property ; rdfs:label "belongs_to_topic" ;
	rdfs:comment "Entity belongs to a topic" .
aiul:fulfills a rdfs:Property ; rdfs:label "fulfills" ;
	rdfs:comment "Learning outcome fulfills a requirement" .
aiul:assesses a rdfs:Property ; rdfs:label "assesses" ;
	rdfs:comment "Seminar assesses a learning outcome" .
aiul:supports a rdfs:Property ; rdfs:label "supports" ;
	rdfs:comment "Research note supports a lecture" .
aiul:source_url a rdfs:Property ; rdfs:label "source_url" ;
	rdfs:range xsd:anyURI .
aiul:source_system a rdfs:Property ; rdfs:label "source_system" ;
	rdfs:comment "google_drive | github | local" ;
	rdfs:range xsd:string .
aiul:updated_at a rdfs:Property ; rdfs:label "updated_at" ;
	rdfs:range xsd:dateTime .
aiul:status a rdfs:Property ; rdfs:label "status" ;
	rdfs:comment "draft | active | archived | deprecated" ;
	rdfs:range xsd:string .
aiul:owner a rdfs:Property ; rdfs:label "owner" ;
	rdfs:range xsd:string .
aiul:version_label a rdfs:Property ; rdfs:label "version_label" ;
	rdfs:range xsd:string .
aiul:GoogleDrive a aiul:SourceSystem ; rdfs:label "google_drive" .
aiul:GitHub a aiul:SourceSystem ; rdfs:label "github" .
aiul:Local a aiul:SourceSystem ; rdfs:label "local" .
aiul:StatusDraft rdfs:label "draft" .
aiul:StatusActive rdfs:label "active" .
aiul:StatusArchived rdfs:label "archived" .
aiul:StatusDeprecated rdfs:label "deprecated" .
