{
  "name": "С7 · стадия 2б — расщепление записи",
  "nodes": [
    {
      "id": "form",
      "name": "Request form",
      "webhookId": "a7f1c0de-2b2b-4c0a-9f11-7b5e2d9c0001",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -180,
        0
      ],
      "parameters": {
        "path": "s7-stage-2b",
        "formTitle": "Заявка в учебный центр · расщепление записи",
        "formDescription": "Так выглядит вход процесса, который мы собираем",
        "formFields": {
          "values": [
            {
              "fieldType": "html",
              "html": "<div style=\"font-size:14px;line-height:1.5\"><p style=\"margin:0 0 10px\">Заявка пройдёт <b>пять шагов</b>. После отправки вы увидите каждый из них на одном экране.</p><p style=\"margin:0 0 6px\"><b>1 · Форма</b> — то, что вы сейчас заполните: имя, контакт и свободный текст. Писать можно как человеку, без формата.</p><p style=\"margin:0 0 6px\"><b>2 · Извлечение</b> — шаг модели достаёт из текста <i>тему</i>, <i>срочность</i> и <i>контакт, указанный в тексте</i>.</p><p style=\"margin:0 0 6px\"><b>3 · Справочник</b> — сверяет тему и срочность со списком допустимых значений. Что не из списка или пусто — станет «другое» и «не указано».</p><p style=\"margin:0 0 6px\"><b>4 · Запись</b> — строка уходит в таблицу заявок.</p><p style=\"margin:0 0 10px\"><b>5 · Экран результата</b> — покажет все четыре шага подряд, здесь же.</p><p style=\"margin:0\"><b>Справочники:</b> тема — курс · перенос занятия · оплата · другое; срочность — сегодня · на неделе · не указано.</p></div>"
            },
            {
              "fieldLabel": "Имя",
              "requiredField": true
            },
            {
              "fieldLabel": "Контакт",
              "placeholder": "телефон или почта",
              "requiredField": true
            },
            {
              "fieldLabel": "Что нужно",
              "fieldType": "textarea",
              "placeholder": "Напишите своими словами — например: «хочу на курс по аналитике, перезвоните сегодня»",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "extract",
      "name": "Extract fields",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1,
      "position": [
        60,
        0
      ],
      "parameters": {
        "text": "={{ $json['Что нужно'] }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"topics\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"курс\",\n          \"перенос занятия\",\n          \"оплата\",\n          \"другое\"\n        ]\n      },\n      \"description\": \"ВСЕ темы, которые есть в заявке, из списка; если тема одна — массив из одного элемента\"\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"сегодня\",\n        \"на неделе\",\n        \"не указано\"\n      ],\n      \"description\": \"когда человек ждёт ответа; если не сказано — «не указано»\"\n    },\n    \"contact_from_text\": {\n      \"type\": \"string\",\n      \"description\": \"телефон или почта, указанные В ТЕКСТЕ заявки; если их нет — пустая строка\"\n    }\n  },\n  \"required\": [\n    \"topics\",\n    \"urgency\"\n  ]\n}",
        "options": {}
      }
    },
    {
      "id": "model",
      "name": "Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        60,
        220
      ],
      "parameters": {
        "model": "openai/gpt-4o-mini",
        "options": {}
      },
      "credentials": {
        "openRouterApi": {
          "id": "VbxiQn8TbqA4R2mw",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "id": "split-topics",
      "name": "Split topics",
