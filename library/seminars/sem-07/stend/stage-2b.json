      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "topic",
              "type": "string",
              "value": "={{ [\"курс\", \"перенос занятия\", \"оплата\", \"другое\"].includes($json['output.topics']) ? $json['output.topics'] : 'другое' }}"
            },
            {
              "id": "a2",
              "name": "urgency",
              "type": "string",
              "value": "={{ [\"сегодня\", \"на неделе\", \"не указано\"].includes($json.output.urgency) ? $json.output.urgency : 'не указано' }}"
            },
            {
              "id": "a3",
              "name": "contact_from_text",
              "type": "string",
              "value": "={{ $json.output.contact_from_text || '' }}"
            },
            {
              "id": "a4",
              "name": "status",
              "type": "string",
              "value": "ok"
            },
            {
              "id": "a5",
              "name": "extra_topics",
              "type": "string",
              "value": ""
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "table",
      "name": "Write row",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        720,
