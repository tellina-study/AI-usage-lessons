      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        30
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const webhookBody = $('Test pair (webhook)').item.json.body;\nconst jevItem = $('Jev decision (noul)').item.json;\nconst judgeItem = $('LLM judge').item.json;\nlet jevNoul = null, jevError = null;\nif (jevItem && jevItem.answers && jevItem.answers.same_question) {\n  jevNoul = jevItem.answers.same_question.noul;\n} else if (jevItem && jevItem.error) {\n  jevError = JSON.stringify(jevItem.error);\n}\nreturn { json: {\n  pair_id: webhookBody.id,\n  jev_noul: jevNoul,\n  jev_error: jevError,\n  llm_judge_raw: (judgeItem && judgeItem.text) || JSON.stringify(judgeItem),\n} };"
      }
    },
    {
      "id": "out",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
