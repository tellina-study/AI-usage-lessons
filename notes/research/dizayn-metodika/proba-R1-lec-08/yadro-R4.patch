+    lo_x, hi_x = x + res, x + w - res
+    lanes = _lanes(d)
+    out = {}
+    for up in (True, False):
+        idx = sorted([i for i in range(len(d["marks"])) if lanes[i] == up],
+                     key=lambda i: d["marks"][i]["v"])
+        if not idx:
+            continue
+        ws = [_lab_w(d["marks"][i], st, cap) for i in idx]
+        mxs = [_x_of(d["marks"][i]["v"], d, x, w, st) for i in idx]
+        lx = [mx - lw / 2 for mx, lw in zip(mxs, ws)]
+        cur = lo_x                                  # слева направо
+        for k in range(len(idx)):
+            lx[k] = max(lx[k], cur)
+            cur = lx[k] + ws[k] + st.lab_gap
+        cur = hi_x                                  # справа налево
+        for k in range(len(idx) - 1, -1, -1):
