@prefix aiul: <https://ai-usage-lessons.local/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# Course structure — canon: library/project/course-plan.md +
# course-plan-seminars.md (owner canon 2026-05-16, issue #97/#95).
# 17 lectures + 17 seminars. covers links lecture -> topic + LO.
# ============================================================

# === Learning Outcomes (labels = canon course-plan.md §"Результаты обучения") ===
aiul:lo1 a aiul:LearningOutcome ;
	rdfs:label "LO1: Classify AI solution types and match them to industry tasks" ;
	aiul:fulfills aiul:req_pks3 .
aiul:lo2 a aiul:LearningOutcome ;
	rdfs:label "LO2: Evaluate applicability of an AI solution to a specific business task" ;
	aiul:fulfills aiul:req_pks3 .
aiul:lo3 a aiul:LearningOutcome ;
	rdfs:label "LO3: Analyze AI-system risks: data security, limitations, vulnerabilities" ;
	aiul:fulfills aiul:req_pks4 .
aiul:lo4 a aiul:LearningOutcome ;
	rdfs:label "LO4: Apply AI tools to solve a typical analytical task" ;
	aiul:fulfills aiul:req_pks3 .
aiul:lo5 a aiul:LearningOutcome ;
	rdfs:label "LO5: Formulate a substantiated conclusion about AI prospects in an industry" ;
	aiul:fulfills aiul:req_pks3 .
aiul:lo6 a aiul:LearningOutcome ;
	rdfs:label "LO6: Identify typical errors and limitations of AI systems" ;
	aiul:fulfills aiul:req_pks4 .
aiul:lo7 a aiul:LearningOutcome ;
	rdfs:label "LO7: Justify the choice of AI architecture (chat, agent, RAG, API, model) for a task" ;
	aiul:fulfills aiul:req_pks4 .
aiul:lo8 a aiul:LearningOutcome ;
	rdfs:label "LO8: Define the role of human and AI in collaboration: strengths, responsibility, human-in-the-loop" ;
	aiul:fulfills aiul:req_pks4 .

# === Requirements (unchanged from prior store; LO->requirement mapping preserved) ===
aiul:req_pks3 a aiul:Requirement ;
	rdfs:label "PKS-3: Classify and identify AI tasks, select adequate methods" ;
	aiul:source_url "https://docs.google.com/document/d/1zgAWfdyWlJBFMElmtKpmjgxySUCRccF9lNT-tj7J4fU/edit"^^xsd:anyURI .
aiul:req_pks4 a aiul:Requirement ;
	rdfs:label "PKS-4: Evaluate ethical and social implications of AI systems" ;
	aiul:source_url "https://docs.google.com/document/d/1zgAWfdyWlJBFMElmtKpmjgxySUCRccF9lNT-tj7J4fU/edit"^^xsd:anyURI .

# === Topics ===
aiul:topic_ai_fundamentals a aiul:Topic ;
	rdfs:label "AI fundamentals and classification" .
aiul:topic_ai_agents a aiul:Topic ;
	rdfs:label "AI agents and autonomous systems" .
aiul:topic_prompt_engineering a aiul:Topic ;
	rdfs:label "Prompt engineering skills" .
aiul:topic_ai_in_software a aiul:Topic ;
	rdfs:label "AI in software development" .
aiul:topic_ai_in_finance a aiul:Topic ;
	rdfs:label "AI in finance and retail" .
aiul:topic_ai_in_medicine a aiul:Topic ;
	rdfs:label "AI in medicine and pharmaceuticals" .
aiul:topic_ai_in_creative a aiul:Topic ;
	rdfs:label "AI in creative industries and media" .
aiul:topic_ai_in_manufacturing a aiul:Topic ;
	rdfs:label "AI in manufacturing and production automation" .
aiul:topic_ai_ethics a aiul:Topic ;
	rdfs:label "AI ethics, regulation and responsibility (cross-cutting)" ;
	rdfs:comment "Cross-cutting theme (LO3/LO8). No dedicated primary lecture in the actualized RPD; covered by several lectures (5, 7, 15, 17)." .
aiul:topic_ai_in_government a aiul:Topic ;
	rdfs:label "AI in government and education (legacy, deprecated)" ;
	rdfs:comment "Legacy from the old (April) course structure. The actualized RPD (canon 2026-05-16) has NO corresponding lecture. Retained for provenance; flagged for owner decision (keep/delete)." ;
	aiul:status "deprecated" .
